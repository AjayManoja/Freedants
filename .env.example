# Server (server/.env)
MONGODB_URI=mongodb://localhost:27017/feedants
PORT=3001
JWT_SECRET=dev-secret-change-in-production
# Hard cap for any upload in MB; competitions can set a lower limit
MAX_UPLOAD_MB=200

# Mobile (mobile/.env) — all optional
# EXPO_PUBLIC_API_URL=https://api.example.com/api
# EXPO_PUBLIC_COMPETITION_SLUG=feedants-classical-dance
# EXPO_PUBLIC_DEMO_USER_ID=000000000000000000000001
